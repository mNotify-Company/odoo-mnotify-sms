<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- SMS Gateway Tree View -->
        <record id="sms_gateway_view_tree" model="ir.ui.view">
            <field name="name">sms.gateway.tree</field>
            <field name="model">sms.gateway</field>
            <field name="arch" type="xml">
                <tree string="SMS Gateways">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="provider"/>
                    <field name="country_prefix"/>
                    <field name="sender_id"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <!-- SMS Gateway Form View -->
        <record id="sms_gateway_view_form" model="ir.ui.view">
            <field name="name">sms.gateway.form</field>
            <field name="model">sms.gateway</field>
            <field name="arch" type="xml">
                <form string="SMS Gateway">
                    <header>
                        <button name="action_test_gateway" type="object" 
                                string="Test Gateway" class="btn-primary"
                                invisible="not api_key or not test_number"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Gateway Name"/>
                            </h1>
                        </div>
                        
                        <group>
                            <group string="Gateway Configuration">
                                <field name="provider"/>
                                <field name="active"/>
                                <field name="sequence"/>
                            </group>
                            <group string="API Configuration">
                                <field name="api_key" password="True" required="active"/>
                                <field name="sender_id"/>
                                <field name="country_prefix" help="Format: +233"/>
                            </group>
                        </group>
                        
                        <group string="Testing">
                            <field name="test_number" placeholder="+233201234567"/>
                        </group>
                        
                        <div class="alert alert-info">
                            <h4>Setup Instructions:</h4>
                            <ol>
                                <li>Get your API key from mNotify dashboard</li>
                                <li>Configure the fields above</li>
                                <li>Set a test number and click "Test Gateway"</li>
                                <li>Enable the gateway to start using it</li>
                            </ol>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- SMS Gateway Action -->
        <record id="sms_gateway_action" model="ir.actions.act_window">
            <field name="name">mNotify SMS Gateways</field>
            <field name="res_model">sms.gateway</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first mNotify SMS Gateway!
                </p>
                <p>
                    Configure mNotify gateways to send SMS messages from Odoo
                    using your own mNotify account instead of expensive IAP credits.
                </p>
            </field>
        </record>

        <menuitem id="menu_sms_gateway_root"
                  name="mNotify SMS"
                  parent="base.menu_administration"
                  sequence="100"/>
                  
        <!-- Sub Menu -->
        <menuitem id="menu_sms_gateway"
                  name="Gateways"
                  parent="menu_sms_gateway_root"
                  action="sms_gateway_action"
                  sequence="10"/>
    </data>
</odoo>